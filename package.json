{
	"name": "pi-durable-a2a",
	"version": "0.2.0",
	"description": "A2A integration for Pi Durable agents",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./litellm": {
			"types": "./dist/litellm.d.ts",
			"import": "./dist/litellm.js",
			"default": "./dist/litellm.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"check": "biome check --write . && tsc --noEmit",
		"check:ci": "biome ci . && tsc --noEmit",
		"test": "vitest --run",
		"agent": "node examples/agent.ts",
		"client": "node examples/client.ts",
		"smoke": "node scripts/gateway-smoke.ts",
		"probe": "node scripts/probe-cancellation-scope.ts",
		"prepack": "npm run build"
	},
	"dependencies": {
		"@a2a-js/sdk": "1.3.0"
	},
	"peerDependencies": {
		"@earendil-works/chord": "1.6.0",
		"@earendil-works/pi-durable": "1.6.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@earendil-works/pi-ai": "1.6.0",
		"@earendil-works/pi-coding-agent": "1.6.0",
		"@types/node": "22.19.19",
		"typescript": "7.0.2",
		"vitest": "4.1.12"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ianphil/pi-durable-a2a.git"
	}
}
