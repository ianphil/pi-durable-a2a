{
	"compilerOptions": {
		"target": "ES2024",
		"module": "Node16",
		"moduleResolution": "Node16",
		"lib": ["ES2024"],
		"strict": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"inlineSources": true,
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,
		"paths": {
			"pi-durable-a2a": ["./src/index.ts"],
			"pi-durable-a2a/litellm": ["./src/litellm.ts"]
		},
		"types": ["node"]
	},
	"include": ["src", "test", "examples", "scripts", "vitest.config.ts"]
}
